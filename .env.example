APP_NAME="PEPEPS Santander"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de Datos Relacional Auxiliar (Sesiones y Caché en Local con Sail)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pepeps
DB_USERNAME=sail
DB_PASSWORD=password

# En producción en la nube (sin MySQL auxiliar), puedes usar sesiones y caché por archivo:
# SESSION_DRIVER=file
# CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Base de Datos NoSQL de Dominio (MongoDB)
# -----------------------------------------------------------------------------
# Opción 1: Desarrollo Local con Docker Sail
MONGO_ROOT_PASSWORD=secret_mongo_root
MONGO_APP_USER=pepeps_app
MONGO_APP_PASSWORD=secret_pepeps_pass
MONGODB_DATABASE=pepeps
MONGODB_URI=mongodb://pepeps_app:secret_pepeps_pass@mongo:27017/pepeps?authSource=pepeps

# Opción 2: MongoDB Atlas en la Nube (Producción / Cloud)
# MONGODB_DATABASE=pepeps
# MONGODB_URI="mongodb+srv://<USUARIO>:<PASSWORD>@<TU-CLUSTER>.mongodb.net/pepeps?retryWrites=true&w=majority&appName=pepeps"

# Autenticación contra la colección MongoDB `usuarios`
AUTH_MODEL=App\Models\Usuario

# Cookies de sesión: en producción (HTTPS) SESSION_SECURE_COOKIE debe ser true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
